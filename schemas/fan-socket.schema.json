{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.zelux.example/fan-socket/v1/schema.json",
  "title": "ZELUX Fan Control Socket Message",
  "oneOf": [{"$ref": "#/$defs/request"}, {"$ref": "#/$defs/response"}],
  "$defs": {
    "request": {
      "type": "object",
      "required": ["api_version", "op"],
      "properties": {
        "api_version": {"const": 1},
        "op": {"enum": ["ping", "status", "get", "temp", "set", "auto", "curve", "selftest", "validate", "create", "update", "delete", "enable", "disable"]},
        "instance_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "confirm": {"type": "boolean"},
        "instance": {"type": "object", "required": ["id", "name", "driver_id", "enabled", "pwm", "period_ns"]},
        "inventory": {"type": "object", "required": ["schema", "mode", "default_pct", "curve", "instances"]},
        "pct": {"type": "integer", "minimum": 0, "maximum": 100},
        "hold_s": {"type": "number", "minimum": 0, "maximum": 3600},
        "points": {"type": "array"}
      },
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"op": {"enum": ["get", "set", "update", "delete", "enable", "disable"]}}}, "then": {"required": ["instance_id"]}},
        {"if": {"properties": {"op": {"const": "delete"}}}, "then": {"required": ["confirm"], "properties": {"confirm": {"const": true}}}},
        {"if": {"properties": {"op": {"enum": ["create", "update"]}}}, "then": {"required": ["instance"]}},
        {"if": {"properties": {"op": {"const": "validate"}}}, "then": {"required": ["inventory"]}},
        {"if": {"properties": {"op": {"const": "set"}}}, "then": {"required": ["pct"]}}
      ]
    },
    "response": {
      "type": "object",
      "required": ["api_version", "ok"],
      "properties": {
        "api_version": {"const": 1}, "ok": {"type": ["boolean", "null"], "description": "null means selftest could not verify rotation, not a successful test"},
        "error": {"type": "string"}, "code": {"type": "string"},
        "pong": {"type": "boolean"}, "inventory": {"type": "object", "required": ["schema", "mode", "default_pct", "curve", "instances"]},
        "items": {"type": "array"}, "instance": {"type": "object"},
        "deleted": {"type": "boolean"}, "released": {"type": "array", "items": {"type": "object", "required": ["resource", "stopped", "unexported"], "properties": {"resource": {"type": "string"}, "stopped": {"type": "boolean"}, "unexported": {"type": "boolean"}}}},
        "mode": {"enum": ["auto", "manual"]}, "temp": {"type": ["number", "null"]},
        "pct": {"type": "integer", "minimum": 0, "maximum": 100}, "curve": {"type": "array"},
        "result": {"type": "object"}
      },
      "additionalProperties": true
    }
  }
}
