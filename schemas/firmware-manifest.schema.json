{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.zelux.example/firmware/v1/schema.json",
  "title": "ZELUX Firmware Manifest",
  "type": "object",
  "required": ["schema", "id", "version", "device_class", "models", "driver", "image", "signature"],
  "properties": {
    "schema": {"const": "zelux.firmware/v1"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{1,127}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+].*)?$"},
    "device_class": {"enum": ["servo", "tof", "camera", "fan", "imu"]},
    "models": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "hardware_revisions": {"type": "array", "items": {"type": "string"}},
    "bootloader": {"type": "string"},
    "driver": {"type": "string"},
    "protocol_after_update": {"type": "string"},
    "image": {
      "type": "object",
      "required": ["file", "sha256"],
      "properties": {
        "file": {"type": "string"},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
        "value": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}

